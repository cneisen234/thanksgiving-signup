# Copy this file to .env.local and fill in the values.

# --- Neon Postgres ---
# The Neon connection string. Use the same database for dev and production, as
# the other sites do. From the Neon dashboard -> your project -> Connect.
# (The simple neon() HTTP client works with either the pooled or direct string.)
DATABASE_URL=

# --- Google reCAPTCHA v3 ---
# Create keys at https://www.google.com/recaptcha/admin (choose "Score based v3").
# SITE key is public (shipped to the browser); SECRET is server-only.
# If these are left blank the form still works (verification is skipped).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
